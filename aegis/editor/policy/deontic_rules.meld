(aegis-schema-version 1)
(case EditorRulesMt)
;; Local-development operator policy. Source files must be operator-approved.
(permittedToDo localOperator (readEditor))
(permittedToDo localOperator (modifyEditor))
;; Release requires the server-verified immutable review evidence.
(permittedToDo localOperator (releaseEditor reviewedSnapshot))
 ;; Local operator approves this explicit device-local disclosure scope.
;; Unknown destinations, classifications and channels are not authorized.
(permittedToDo localOperator (sendEditorInference localEndpoint publicData metadataChannel))
(permittedToDo localOperator (sendEditorInference localEndpoint publicData capabilityChannel))
(permittedToDo localOperator (sendEditorInference localEndpoint publicData authoringChannel))
(permittedToDo localOperator (sendEditorInference localEndpoint publicData documentChannel))
(permittedToDo localOperator (sendEditorInference localEndpoint internalData metadataChannel))
(permittedToDo localOperator (sendEditorInference localEndpoint internalData capabilityChannel))
(permittedToDo localOperator (sendEditorInference localEndpoint internalData authoringChannel))
(permittedToDo localOperator (sendEditorInference localEndpoint internalData documentChannel))
(permittedToDo localOperator (sendEditorInference localEndpoint confidentialData metadataChannel))
(permittedToDo localOperator (sendEditorInference localEndpoint confidentialData capabilityChannel))
(permittedToDo localOperator (sendEditorInference localEndpoint confidentialData authoringChannel))
(permittedToDo localOperator (sendEditorInference localEndpoint confidentialData documentChannel))
(forbiddenToDo localOperator (sendEditorInference remoteEndpoint publicData metadataChannel))
(forbiddenToDo localOperator (sendEditorInference remoteEndpoint publicData capabilityChannel))
(forbiddenToDo localOperator (sendEditorInference remoteEndpoint publicData authoringChannel))
(forbiddenToDo localOperator (sendEditorInference remoteEndpoint publicData documentChannel))
(forbiddenToDo localOperator (sendEditorInference remoteEndpoint internalData metadataChannel))
(forbiddenToDo localOperator (sendEditorInference remoteEndpoint internalData capabilityChannel))
(forbiddenToDo localOperator (sendEditorInference remoteEndpoint internalData authoringChannel))
(forbiddenToDo localOperator (sendEditorInference remoteEndpoint internalData documentChannel))
(forbiddenToDo localOperator (sendEditorInference remoteEndpoint confidentialData metadataChannel))
(forbiddenToDo localOperator (sendEditorInference remoteEndpoint confidentialData capabilityChannel))
(forbiddenToDo localOperator (sendEditorInference remoteEndpoint confidentialData authoringChannel))
(forbiddenToDo localOperator (sendEditorInference remoteEndpoint confidentialData documentChannel))
